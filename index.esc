</head>

<body>

<header>

<div class="top">

<div>
<div class="logo">🛒 Anjali Super Mart</div>
<div class="location">📍 Amanora, Hadapsar, Pune</div>
</div>

<button class="cartTop" onclick="openCart()">
🛒 Cart <span id="cartCount">0</span>
</button>

</div>

<input
id="search"
class="search"
placeholder="🔍 Search vegetables, fruits, grocery..."
oninput="renderProducts()"
>

</header>

<div class="banner">

<h2>Daily Grocery 🛍️</h2>

<p>Fresh products • Best prices • Easy ordering</p>

</div>

<div class="categories" id="categories"></div>

<h2 class="title">Products</h2>

<div class="grid" id="products"></div>

<div class="bottomCart" onclick="openCart()">

<div>
🛒 <b><span id="bottomCount">0</span> Items</b>
</div>

<div>
₹<span id="bottomTotal">0</span> → View Cart
</div>

</div>

<!-- CART -->

<div class="modal" id="cartModal">

<div class="modalBox">

<button class="close" onclick="closeCart()">✕</button>

<h2>🛒 Your Cart</h2>

<div id="cartItems"></div>

<h3 style="margin-top:15px">
Total: ₹<span id="cartTotal">0</span>
</h3>

<div class="form">

<h3 style="margin-top:20px">Delivery Details</h3>

<input id="customerName" placeholder="Your Name">

<input id="customerMobile" placeholder="Mobile Number" type="tel">

<textarea id="customerAddress" placeholder="Delivery Address"></textarea>

<button class="place" onclick="placeOrder()">
📲 Place Order
</button>

</div>

</div>

</div>

<script>

let products = [];
let cart = [];
let selectedCategory = "All";

async function loadProducts(){

  const res = await fetch("/api/products");

  products = await res.json();

  createCategories();

  renderProducts();

}

function createCategories(){

  const categories = ["All", ...new Set(products.map(p => p.category))];

  const box = document.getElementById("categories");

  box.innerHTML = categories.map(cat => `

    <button
      class="cat ${cat === selectedCategory ? "active" : ""}"
      onclick="selectCategory('${cat}')"
    >
      ${cat}
    </button>

  `).join("");

}

function selectCategory(category){

  selectedCategory = category;

  createCategories();

  renderProducts();

}

function renderProducts(){

  const search = document
    .getElementById("search")
    .value
    .toLowerCase();

  let list = products.filter(p => {

    const categoryMatch =
      selectedCategory === "All" ||
      p.category === selectedCategory;

    const searchMatch =
      p.name.toLowerCase().includes(search);

    return categoryMatch && searchMatch;

  });

  const box = document.getElementById("products");

  if(!list.length){

    box.innerHTML =
      `<div class="empty">Product नहीं मिला</div>`;

    return;

  }

  box.innerHTML = list.map(p => `

    <div class="card">

      <div class="pic">${p.emoji}</div>

      <div class="name">${p.name}</div>

      <div class="unit">${p.unit}</div>

      <div class="price">₹${p.price}</div>

      <button class="add" onclick="addToCart(${p.id})">
        + Add
      </button>

    </div>

  `).join("");

}

function addToCart(id){

  const product = products.find(p => p.id === id);

  const existing = cart.find(item => item.id === id);

  if(existing){

    existing.qty++;

  }else{

    cart.push({
      ...product,
      qty:1
    });

  }

  updateCart();

}

function increase(id){

  const item = cart.find(i => i.id === id);

  if(item){
    item.qty++;
  }

  updateCart();

  renderCart();

}

function decrease(id){

  const item = cart.find(i => i.id === id);

  if(!item) return;

  item.qty--;

  if(item.qty <= 0){

    cart = cart.filter(i => i.id !== id);

  }

  updateCart();

  renderCart();

}

function updateCart(){

  const count =
    cart.reduce((sum,item) => sum + item.qty,0);

  const total =
    cart.reduce((sum,item) => sum + item.price * item.qty,0);

  document.getElementById("cartCount").textContent = count;

  document.getElementById("bottomCount").textContent = count;

  document.getElementById("bottomTotal").textContent = total;

}

function openCart(){

  document.getElementById("cartModal").style.display = "block";

  renderCart();

}

function closeCart(){

  document.getElementById("cartModal").style.display = "none";

}

function renderCart(){

  const box =
    document.getElementById("cartItems");

  if(!cart.length){

    box.innerHTML =
      `<div class="empty">Cart खाली है 🛒</div>`;

    document.getElementById("cartTotal").textContent = "0";

    return;

  }

  let total = 0;

  box.innerHTML = cart.map(item => {

    const itemTotal = item.price * item.qty;

    total += itemTotal;

    return `

      <div class="cartItem">

        <div>

          <b>${item.emoji} ${item.name}</b>

          <div>₹${item.price} × ${item.qty}</div>

        </div>

        <div class="qty">

          <button onclick="decrease(${item.id})">−</button>

          <b>${item.qty}</b>

          <button onclick="increase(${item.id})">+</button>

        </div>

      </div>

    `;

  }).join("");

  document.getElementById("cartTotal").textContent = total;

}

async function placeOrder(){

  if(!cart.length){

    alert("Cart खाली है");

    return;

  }

  const name =
    document.getElementById("customerName").value.trim();

  const mobile =
    document.getElementById("customerMobile").value.trim();

  const address =
    document.getElementById("customerAddress").value.trim();

  if(!name || !mobile || !address){

    alert("Name, Mobile और Address भरें");

    return;

  }

  const total =
    cart.reduce(
      (sum,item) => sum + item.price * item.qty,
      0
    );

  const orderItems = cart.map(item => ({

    id:item.id,
    name:item.name,
    price:item.price,
    unit:item.unit,
    qty:item.qty,
    total:item.price * item.qty

  }));

  try{

    const response = await fetch("/api/orders",{

      method:"POST",

      headers:{
        "Content-Type":"application/json"
      },

      body:JSON.stringify({

        customer:{
          name,
          mobile,
          address
        },

        items:orderItems,

        total

      })

    });

    const data = await response.json();

    if(!data.success){

      alert(data.message || "Order नहीं हुआ");

      return;

    }

    const order = data.order;

    let message =
      `🛒 *Anjali Super Mart Order*%0A%0A`;

    message +=
      `Order ID: ${order.id}%0A`;

    message +=
      `Name: ${name}%0A`;

    message +=
      `Mobile: ${mobile}%0A`;

    message +=
      `Address: ${address}%0A%0A`;

    message += `*Items:*%0A`;

    orderItems.forEach(item => {

      message +=
        `${item.name} × ${item.qty} = ₹${item.total}%0A`;

    });

    message += `%0A*Total: ₹${total}*`;

    const whatsapp =
      "https://wa.me/916375889488?text=" + message;

    alert(
      "Order Successfully Placed ✅\n\nOrder ID: " +
      order.id
    );

    cart = [];

    updateCart();

    closeCart();

    window.open(whatsapp,"_blank");

  }catch(error){

    console.error(error);

    alert(
      "Server से connection नहीं हुआ ❌"
    );

  }

}

loadProducts();

</script>

</body>
</html>
EOF

